[Unit]
Description=Teensy TCP Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=photogrammetry
WorkingDirectory=/home/photogrammetry/Sigma_Lens_Control/teensy_bridge
ExecStart=/home/photogrammetry/Sigma_Lens_Control/.venv/bin/python /home/photogrammetry/Sigma_Lens_Control/teensy_bridge/teensy_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
