[Unit]
Description=ASI Camera TCP Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=photogrammetry
WorkingDirectory=/home/photogrammetry/Sigma_Lens_Control/asi_bridge
ExecStart=/home/photogrammetry/Sigma_Lens_Control/.venv/bin/python /home/photogrammetry/Sigma_Lens_Control/asi_bridge/asi_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

